# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Vercel Cron Keep-Alive Secret (Optional but recommended)
CRON_SECRET=your-random-cron-secret-token

# Email Service (Resend)
RESEND_API_KEY=re_your_resend_api_key
CONTACT_EMAIL_FROM=NIMO Inquiries <onboarding@resend.dev>
CONTACT_EMAIL_TO=contact@nimo.africa

# Fapshi Payment Gateway (Cameroon - MTN / Orange Money & Cards)
FAPSHI_ENV=sandbox
FAPSHI_API_USER=your_fapshi_api_user
FAPSHI_API_KEY=your_fapshi_api_key
FAPSHI_WEBHOOK_SECRET=your_fapshi_webhook_secret
